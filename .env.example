# ORCA Environment Template - copy to .env and fill values
# Never commit .env

# Backend
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database - least-privilege app user per 14_SECURITY (postgres superuser only for migrations)
DATABASE_URL=postgresql+psycopg://orca_app:orca_app_pass@localhost:5432/orca_db
DATABASE_URL_ADMIN=postgresql+psycopg://postgres:postgres@localhost:5432/orca_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orca_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# MinIO
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_DOCUMENTS=orca-documents
MINIO_BUCKET_RAW=orca-raw-data
MINIO_BUCKET_SATELLITE=orca-satellite

# LLM API - shared across all agents — auto-detect (gsk_->groq, AIza->gemini, else openai)
# Groq (FREE): console.groq.com -> gsk_... + LLM_MODEL=llama-3.3-70b-versatile
# Gemini (FREE): aistudio.google.com -> AIza... + LLM_MODEL=gemini-2.0-flash
# OpenAI (PAID): platform.openai.com -> sk-... + LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=
LLM_BASE_URL=

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
